# GitHub token with read access to Actions runs and artifacts.
GITHUB_TOKEN=
# Repository in owner/repo format.
GITHUB_REPOSITORY=
# Optional application defaults.
SYFT_BRANCH=main
SYFT_JUNIT_ARTIFACT=

# Optional LLM explanations. Classification never comes from the LLM.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Required only when running `python -m syft agent --execute`.
LINEAR_API_KEY=
LINEAR_TEAM_ID=
SLACK_WEBHOOK_URL=
